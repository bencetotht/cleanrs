class Cleanrs < Formula
  desc "Storage analyzer with honest reclaimability intervals and developer cache cleanup"
  homepage "https://github.com/bencetotht/cleanrs"
  version "@VERSION@"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/bencetotht/cleanrs/releases/download/v@VERSION@/cleanrs-@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA_AARCH64_APPLE_DARWIN@"
    end
    on_intel do
      url "https://github.com/bencetotht/cleanrs/releases/download/v@VERSION@/cleanrs-@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA_X86_64_APPLE_DARWIN@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/bencetotht/cleanrs/releases/download/v@VERSION@/cleanrs-@VERSION@-aarch64-unknown-linux-musl.tar.gz"
      sha256 "@SHA_AARCH64_UNKNOWN_LINUX_MUSL@"
    end
    on_intel do
      url "https://github.com/bencetotht/cleanrs/releases/download/v@VERSION@/cleanrs-@VERSION@-x86_64-unknown-linux-musl.tar.gz"
      sha256 "@SHA_X86_64_UNKNOWN_LINUX_MUSL@"
    end
  end

  def install
    bin.install "cleanrs"
    man1.install "man/cleanrs.1"
    bash_completion.install "completions/cleanrs.bash" => "cleanrs"
    zsh_completion.install "completions/_cleanrs"
    fish_completion.install "completions/cleanrs.fish"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/cleanrs --version")
  end
end
